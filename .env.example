# EcoVision Environment Variables Template

# Backend Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Supabase Database & Auth & Storage
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-backend-only
STORAGE_BUCKET_NAME=bird-observations

# Model & Inference Settings
MODEL_ARCHITECTURE=resnet50
MODEL_WEIGHTS_PATH=
CONFIDENCE_HIGH_THRESHOLD=0.80
CONFIDENCE_MEDIUM_THRESHOLD=0.50
MAX_UPLOAD_SIZE_MB=10

# Frontend Configuration (for Vite)
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
